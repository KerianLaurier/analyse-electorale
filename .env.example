# Valeurs factices : démarrage et tests publics uniquement.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# URL du bucket public contenant les JSON et PMTiles, ou vide pour /public.
NEXT_PUBLIC_DATA_URL=
# Vide en local/preview ; https://app.votre-domaine.fr en production.
NEXT_PUBLIC_APP_URL=

# Secrets exclusivement serveur, jamais préfixés NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observabilité / audience facultatives.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_GA_ID=

# Compte de test uniquement, pour les parcours E2E authentifiés.
E2E_EMAIL=
E2E_PASSWORD=
