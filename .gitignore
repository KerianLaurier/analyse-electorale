# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data pipeline (sources brutes regénérables via scripts/pipeline/all.sh)
/data/

# Bundles DuckDB-WASM self-hostés — copiés depuis node_modules par
# scripts/copy-duckdb.mjs (lancé automatiquement avant dev/build).
/public/duckdb/

# Playwright (artefacts de tests E2E)
/test-results/
/playwright-report/

# Données lourdes servies depuis Supabase Storage (cf. docs/object-store.md) —
# plus versionnées. Régénérables via scripts/pipeline/, (re)poussées au storage
# par scripts/pipeline/upload-storage.mjs. public/sondages + public/suivi restent
# commités (légers, rafraîchis quotidiennement par sondages.yml qui les uploade aussi).
/public/electoral/
/public/tiles/
/public/insee/
/public/an/
/public/search-index.json

# Maquettes design (référence, lourdes) — on garde TOKENS.md
/design/*.html

# Outils macOS
.DS_Store

# python caches
__pycache__/
*.pyc

# Workers MapLibre reconstruits depuis la version verrouillée avant dev/build
/public/maplibre/
.venv/
